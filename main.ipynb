{\n  "nbformat": 4,\n  "nbformat_minor": 5,\n  "metadata": {},\n  "cells": [\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 1 — Install compatible dependencies"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "!pip install -q \\\n",\n        "    qiskit==1.0.2 \\\n",\n        "    qiskit-aer==0.14.1 \\\n",\n        "    qiskit-optimization==0.6.1 \\\n",\n        "    qiskit-algorithms==0.3.0 \\\n",\n        "    qiskit-ibm-runtime==0.23.0 \\\n",\n        "    networkx pandas matplotlib pylatexenc\n"\n      ]\n    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 2 — Imports and configuration"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "import os\n",\n        "import time\n",\n        "import itertools\n",\n        "import warnings\n",\n        "import platform\n",\n        "import numpy as np\n",\n        "import pandas as pd\n",\n        "import networkx as nx\n",\n        "import matplotlib.pyplot as plt\n",\n        "import qiskit\n",\n        "import qiskit_aer\n",\n        "import qiskit_algorithms\n",\n        "import qiskit_optimization\n",\n        "import qiskit_ibm_runtime\n",\n        "from qiskit_aer import AerSimulator\n",\n        "from qiskit_aer.primitives import Sampler as AerSampler\n",\n        "from qiskit_ibm_runtime.fake_provider import (\n",\n        "    FakeManilaV2,\n",\n        "    FakeNairobiV2,\n",\n        ")\n",\n        "from qiskit_optimization.applications import Maxcut\n",\n        "from qiskit_algorithms import QAOA\n",\n        "from qiskit_algorithms.optimizers import COBYLA\n",\n        "warnings.filterwarnings('ignore')\n",\n        "\n",\n        "SHOTS = 1024\n",\n        "SEED = 42\n",\n        "QAOA_REPS = 2\n",\n        "MAX_ITER = 50\n",\n        "\n",\n        "BASE_DIR = 'results'\n",\n        "TABLE_DIR = os.path.join(BASE_DIR, 'tables')\n",\n        "FIGURE_DIR = os.path.join(BASE_DIR, 'figures')\n",\n        "os.makedirs(TABLE_DIR, exist_ok=True)\n",
        "os.makedirs(FIGURE_DIR, exist_ok=True)\n",
        "\n",
        "print('Python:', platform.python_version())\n",
        "print('Qiskit:', qiskit.__version__)\n",
        "print('Qiskit Aer:', qiskit_aer.__version__)\n",
        "print('Qiskit Algorithms:', qiskit_algorithms.__version__)\n",
        "print('Qiskit Optimization:', qiskit_optimization.__version__)\n",
        "print('Qiskit IBM Runtime:', qiskit_ibm_runtime.__version__)\n"\n      ]\n    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 3 — Define the original Max-Cut problem"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "G = nx.Graph()\n",\n        "G.add_edges_from([\n",\n        "    (0, 1),\n",\n        "    (1, 2),\n",\n        "    (2, 3),\n",\n        "    (3, 4),\n",\n        "    (4, 0),\n",\n        "    (0, 2),\n",\n        "])\n",\n        "maxcut = Maxcut(G)\n",\n        "qp = maxcut.to_quadratic_program()\n",\n        "observable, offset = qp.to_ising()\n",\n        "N_QUBITS = G.number_of_nodes()\n",\n        "print('Nodes:', list(G.nodes()))\n",\n        "print('Edges:', list(G.edges()))\n",\n        "print('Number of qubits:', N_QUBITS)\n",\n        "print('Ising offset:', offset)\n",\n        "\n",\n        "plt.figure(figsize=(7, 5))\n",\n        "pos = nx.spring_layout(G, seed=SEED)\n",\n        "nx.draw_networkx(\n",\n        "    G,\n",\n        "    pos=pos,\n",\n        "    with_labels=True,\n",\n        "    node_color='lightblue',\n",\n        "    node_size=1000,\n",\n        "    font_size=12,\n",\n        "    font_weight='bold',\n",\n        "    edge_color='gray',\n",\n        "    width=2,\n",\n        ")\n",\n        "plt.title('Max-Cut Benchmark Graph')\n",\n        "plt.axis('off')\n",\n        "plt.tight_layout()\n",\n        "graph_path = os.path.join(FIGURE_DIR, 'maxcut_graph.png')\n",\n        "plt.savefig(graph_path, dpi=300, bbox_inches='tight')\n",\n        "plt.show()\n"\n      ]\n    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 4 — Calculate the exact classical optimum"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "all_candidates = []\n",\n        "for bits in itertools.product([0, 1], repeat=N_QUBITS):\n",
        "    cut_value = float(maxcut.objective_value(list(bits)))\n",
        "    all_candidates.append({\n",
        "        'Bitstring': ''.join(map(str, bits)),\n",
        "        'Cut_Value': cut_value,\n",
        "    })\n",
        "classical_df = pd.DataFrame(all_candidates)\n",
        "OPTIMAL_CUT = float(classical_df['Cut_Value'].max())\n",
        "optimal_bitstrings = classical_df.loc[\n",
        "    classical_df['Cut_Value'] == OPTIMAL_CUT,\n",
        "    'Bitstring'\n",
        "].tolist()\n",
        "classical_df.to_csv(\n",
        "    os.path.join(TABLE_DIR, 'classical_maxcut_all_candidates.csv'),\n",
        "    index=False,\n",
        ")\n",
        "print('Exact classical optimum:', OPTIMAL_CUT)\n",
        "print('Optimal assignments:', optimal_bitstrings)\n",
        "print('Total assignments checked:', len(classical_df))\n"\n      ]\n    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 5 — Configure the two noisy fake processors"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "processors = {\n",
        "    'Processor_A_FakeManila': FakeManilaV2(),\n",
        "    'Processor_B_FakeNairobi': FakeNairobiV2(),\n",
        "}\n",
        "\n",
        "def create_noisy_sampler(fake_backend, seed):\n",
        "    simulator = AerSimulator.from_backend(fake_backend)\n",
        "    config = simulator.configuration()\n",
        "    backend_options = {\n",
        "        'noise_model': simulator.options.noise_model,\n",
        "        'basis_gates': list(config.basis_gates),\n",
        "        'coupling_map': config.coupling_map,\n",
        "        'seed_simulator': seed,\n",
        "    }\n",
        "    transpile_options = {\n",
        "        'basis_gates': list(config.basis_gates),\n",
        "        'coupling_map': config.coupling_map,\n",
        "        'optimization_level': 1,\n",
        "        'seed_transpiler': seed,\n",
        "    }\n",
        "    sampler = AerSampler(\n",
        "        backend_options=backend_options,\n",
        "        transpile_options=transpile_options,\n",
        "        run_options={\n",
        "            'shots': SHOTS,\n",
        "            'seed': seed,\n",
        "        },\n",
        "    )\n",
        "    return sampler, simulator\n",
        "\n",
        "for name, backend in processors.items():\n",
        "    print(\n",
        "        f'{name}: '\n",
        "        f'{backend.num_qubits} physical qubits available; '\n",
        "        f'{N_QUBITS} logical qubits required'\n",
        "    )\n"\n      ]\n    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 6 — Corrected QAOA benchmarking function"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "def decode_distribution(eigenstate, num_qubits):\n",
        "    if hasattr(eigenstate, 'binary_probabilities'):\n",
        "        raw_distribution = eigenstate.binary_probabilities()\n",
        "    elif hasattr(eigenstate, 'items'):\n",
        "        raw_distribution = dict(eigenstate.items())\n",
        "    elif hasattr(eigenstate, 'probabilities_dict'):\n",
        "        raw_distribution = eigenstate.probabilities_dict()\n",
        "    else:\n",
        "        raise TypeError(f'Unsupported QAOA eigenstate type: {type(eigenstate)}')\n",
        "    \n",
        "    distribution = {}\n",
        "    for key, probability in raw_distribution.items():\n",
        "        if isinstance(key, str):\n",
        "            bitstring = key.replace(' ', '').zfill(num_qubits)[::-1]\n",
        "        else:\n",
        "            state_int = int(key)\n",
        "            bitstring = format(state_int, f'0{num_qubits}b')[::-1]\n",
        "        if len(bitstring) != num_qubits:\n",
        "            continue\n",
        "        distribution[bitstring] = distribution.get(bitstring, 0.0) + float(np.real(probability))\n",
        "    \n",
        "    distribution = {bits: max(0.0, probability) for bits, probability in distribution.items()}\n",
        "    total = sum(distribution.values())\n",
        "    if total <= 0:\n",
        "        raise ValueError('The QAOA probability distribution is empty.')\n",
        "    return {bits: probability / total for bits, probability in distribution.items()}\n",
        "\n",
        "def benchmark_qaoa(processor_name, fake_backend, seed):\n",
        "    print(f'Benchmarking {processor_name}...')\n",
        "    sampler, simulator = create_noisy_sampler(fake_backend, seed)\n",
        "    optimizer = COBYLA(maxiter=MAX_ITER)\n",
        "    qaoa = QAOA(sampler, optimizer, reps=QAOA_REPS)\n",
        "    \n",
        "    start_time = time.time()\n",
        "    result = qaoa.compute_minimum_eigenvalue(observable)\n",
        "    execution_time = time.time() - start_time\n",
        "    \n",
        "    distribution = decode_distribution(result.eigenstate, N_QUBITS)\n",
        "    \n",
        "    best_bitstring = None\n",
        "    best_cut = -1.0\n",
        "    expected_cut = 0.0\n",
        "    optimal_prob = 0.0\n",
        "    \n",
        "    candidates = []\n",
        "    for bitstring, prob in distribution.items():\n",
        "        x = [int(bit) for bit in bitstring]\n",
        "        cut_val = maxcut.objective_value(x)\n",
        "        expected_cut += cut_val * prob\n",
        "        if cut_val > best_cut:\n",
        "            best_cut = cut_val\n",
        "            best_bitstring = bitstring\n",
        "        if np.isclose(cut_val, OPTIMAL_CUT):\n",
        "            optimal_prob += prob\n",
        "        \n",
        "        candidates.append({\n",
        "            'Bitstring': bitstring,\n",
        "            'Probability': prob,\n",
        "            'Cut_Value': cut_val\n",
        "        })\n",
        "    \n",
        "    candidates_df = pd.DataFrame(candidates)\n",
        "    \n",
        "    row = {\n",
        "        'Processor': processor_name,\n",
        "        'Backend_Qubits': fake_backend.num_qubits,\n",
        "        'Logical_Qubits': N_QUBITS,\n",
        "        'Shots': SHOTS,\n",
        "        'QAOA_Reps': QAOA_REPS,\n",
        "        'Max_Iterations': MAX_ITER,\n",
        "        'Execution_Time_sec': round(execution_time, 2),\n",
        "        'Best_Bitstring': best_bitstring,\n",
        "        'Best_Observed_Cut': best_cut,\n",
        "        'Expected_Cut': expected_cut,\n",
        "        'Classical_Optimal_Cut': OPTIMAL_CUT,\n",
        "        'Approximation_Ratio': expected_cut / OPTIMAL_CUT if OPTIMAL_CUT > 0 else 0,\n",
        "        'Optimal_Cut_Probability': optimal_prob,\n",
        "        'Optimizer_Evaluations': getattr(result.optimizer_result, 'nfev', getattr(result, 'cost_function_evals', np.nan)),\n",
        "        'Success': True,\n",
        "        'Error': ''\n",
        "    }\n",
        "    return row, candidates_df\n"\n      ]\n    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 7 — Run both benchmarks and save results"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "results_data = []\n",\n        "candidate_distributions = {}\n",\n        "for name, backend in processors.items():\n",
        "    try:\n",
        "        row, candidates_df = benchmark_qaoa(\n",
        "            processor_name=name,\n",
        "            fake_backend=backend,\n",
        "            seed=SEED,\n",
        "        )\n",
        "        results_data.append(row)\n",
        "        candidate_distributions[name] = candidates_df\n",
        "        print(f\"Best observed cut: {row['Best_Observed_Cut']} / {row['Classical_Optimal_Cut']}\")\n",
        "        print(f\"Expected cut: {row['Expected_Cut']}\")\n",
        "        print(f\"Runtime: {row['Execution_Time_sec']} seconds\")\n",
        "    except Exception as exc:\n",
        "        warnings.warn(f\"{name} failed: {exc}\")\n",
        "        results_data.append({\n",
        "            'Processor': name,\n",
        "            'Backend_Qubits': backend.num_qubits,\n",
        "            'Logical_Qubits': N_QUBITS,\n",
        "            'Shots': SHOTS,\n",
        "            'QAOA_Reps': QAOA_REPS,\n",
        "            'Max_Iterations': MAX_ITER,\n",
        "            'Execution_Time_sec': np.nan,\n",
        "            'Best_Bitstring': None,\n",
        "            'Best_Observed_Cut': np.nan,\n",
        "            'Expected_Cut': np.nan,\n",
        "            'Classical_Optimal_Cut': OPTIMAL_CUT,\n",
        "            'Approximation_Ratio': np.nan,\n",
        "            'Optimal_Cut_Probability': np.nan,\n",
        "            'Optimizer_Evaluations': np.nan,\n",
        "            'Success': False,\n",
        "            'Error': str(exc),\n",
        "        })\n",
        "\n",
        "df_results = pd.DataFrame(results_data)\n",
        "results_csv = os.path.join(TABLE_DIR, 'PS_O1_benchmark_results.csv')\n",
        "df_results.to_csv(results_csv, index=False)\n",
        "print('\\n========== BENCHMARK RESULTS ==========')\n",
        "display(df_results)\n",
        "print('\\nSaved results to:', results_csv)\n"\n      ]\n    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 8 — Visualize the results"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "successful = df_results[df_results['Success'] == True].copy()\n",
        "if successful.empty:\n",
        "    print('No successful runs. Inspect the Error column in df_results.')\n",
        "else:\n",
        "    plt.figure(figsize=(8, 5))\n",
        "    plt.bar(successful['Processor'], successful['Expected_Cut'])\n",
        "    plt.axhline(OPTIMAL_CUT, linestyle='--', label=f'Classical optimum = {OPTIMAL_CUT:g}')\n",
        "    plt.ylabel('Expected Max-Cut value')\n",
        "    plt.title('QAOA Expected Cut by Fake Backend')\n",
        "    plt.legend()\n",
        "    plt.xticks(rotation=10)\n",
        "    plt.tight_layout()\n",
        "    quality_path = os.path.join(FIGURE_DIR, 'expected_cut_comparison.png')\n",
        "    plt.savefig(quality_path, dpi=300, bbox_inches='tight')\n",
        "    plt.show()\n",
        "\n",
        "    plt.figure(figsize=(8, 5))\n",
        "    plt.bar(successful['Processor'], successful['Approximation_Ratio'])\n",
        "    plt.axhline(1.0, linestyle='--', label='Exact optimum')\n",
        "    plt.ylabel('Approximation ratio')\n",
        "    plt.title('QAOA Approximation Ratio by Fake Backend')\n",
        "    plt.legend()\n",
        "    plt.xticks(rotation=10)\n",
        "    plt.tight_layout()\n",
        "    ratio_path = os.path.join(FIGURE_DIR, 'approximation_ratio_comparison.png')\n",
        "    plt.savefig(ratio_path, dpi=300, bbox_inches='tight')\n",
        "    plt.show()\n",
        "\n",
        "    plt.figure(figsize=(8, 5))\n",
        "    plt.bar(successful['Processor'], successful['Execution_Time_sec'])\n",
        "    plt.ylabel('Wall-clock time (seconds)')\n",
        "    plt.title('Noisy Simulation Runtime Comparison')\n",
        "    plt.xticks(rotation=10)\n",
        "    plt.tight_layout()\n",
        "    runtime_path = os.path.join(FIGURE_DIR, 'runtime_comparison.png')\n",
        "    plt.savefig(runtime_path, dpi=300, bbox_inches='tight')\n",
        "    plt.show()\n",
        "\n",
        "    print('Figures saved in:', FIGURE_DIR)\n"\n      ]\n    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": ["### Cell 9 — Export candidate distributions and a ZIP archive"]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "import zipfile\n",
        "for processor_name, candidates_df in candidate_distributions.items():\n",
        "    safe_name = processor_name.replace(' ', '_')\n",
        "    candidates_df.to_csv(\n",
        "        os.path.join(TABLE_DIR, f'{safe_name}_candidate_distribution.csv'),\n",
        "        index=False,\n",
        "    )\n",
        "\n",
        "zip_path = 'PS_O1_QAOA_benchmark_results.zip'\n",
        "with zipfile.ZipFile(zip_path, 'w', zipfile.ZIP_DEFLATED) as archive:\n",
        "    for root, _, files in os.walk(BASE_DIR):\n",
        "        for filename in files:\n",
        "            full_path = os.path.join(root, filename)\n",
        "            archive.write(full_path, arcname=full_path)\n",
        "print('ZIP archive created:', zip_path)\n",
        "print('\\nFiles generated:')\n",
        "for root, _, files in os.walk(BASE_DIR):\n",
        "    for filename in files:\n",
        "        print(os.path.join(root, filename))\n"\n      ]\n    }\n  ]\n}
