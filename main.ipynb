{\n "cells": [\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "# ==========================================\\n",\n    "# 1. DEPENDENCY INSTALLATION (Google Colab)\\n",\n    "# ==========================================\\n",\n    "!pip install -q qiskit==1.0.2 qiskit-aer==0.14.1 qiskit-optimization==0.6.1 qiskit-algorithms==0.3.0 networkx pandas matplotlib pylatexenc qiskit-ibm-runtime\\n",\n    "\\n",\n    "# ==========================================\\n",\n    "# 2. IMPORTS & FOLDER STRUCTURE SETUP\\n",\n    "# ==========================================\\n",\n    "import os\\n",\n    "import time\\n",\n    "import numpy as np\\n",\n    "import pandas as pd\\n",\n    "import networkx as nx\\n",\n    "import matplotlib.pyplot as plt\\n",\n    "import warnings\\n",\n    "\\n",\n    "from qiskit_aer import AerSimulator\\n",\n    "from qiskit_aer.primitives import Sampler as AerSampler\\n",\n    "from qiskit_ibm_runtime.fake_provider import FakeManilaV2, FakeNairobiV2\\n",\n    "from qiskit_optimization.applications import Maxcut\\n",\n    "from qiskit_algorithms import QAOA\\n",\n    "from qiskit_algorithms.optimizers import COBYLA\\n",\n    "\\n",\n    "warnings.filterwarnings('ignore')\\n",\n    "\\n",\n    "dirs = {'tables': 'results/tables', 'figures': 'results/figures'}\\n",\n    "for path in dirs.values():\\n",\n    "    os.makedirs(path, exist_ok=True)\\n",\n    "\\n",\n    "# ==========================================\\n",\n    "# 3. PROBLEM DEFINITION (MAX-CUT GRAPH)\\n",\n    "# ==========================================\\n",\n    "G = nx.Graph()\\n",\n    "G.add_edges_from([(0, 1), (1, 2), (2, 3), (3, 4), (4, 0), (0, 2)])\\n",\n    "\\n",\n    "maxcut = Maxcut(G)\\n",\n    "qp = maxcut.to_quadratic_program()\\n",\n    "observable, offset = qp.to_ising()\\n",\n    "\\n",\n    "# ==========================================\\n",\n    "# 4. PROCESSOR CONFIGURATION\\n",\n    "# ==========================================\\n",\n    "processors = {\\n",\n    "    'Processor_A': FakeManilaV2(),\\n",\n    "    'Processor_B': FakeNairobiV2()\\n",\n    "}\\n",\n    "\\n",\n    "# ==========================================\\n",\n    "# 5. BENCHMARKING FUNCTION (QAOA EXECUTION)\\n",\n    "# ==========================================\\n",\n    "def benchmark_qaoa(processor_name, backend, observable):\\n",\n    "    print(f\\\"Benchmarking {processor_name}...\\\")\\n",\n    "    \\n",\n    "    simulator = AerSimulator.from_backend(backend)\\n",\n    "    \\n",\n    "    sampler = AerSampler(\\n",\n    "        backend_options={\\n",\n    "            \\\"noise_model\\\": simulator.noise_model,\\n",\n    "            \\\"coupling_map\\\": simulator.coupling_map,\\n",\n    "            \\\"basis_gates\\\": simulator.operation_names\\n",\n    "        },\\n",\n    "        run_options={\\\"shots\\\": 1024}\\n",\n    "    )\\n",\n    "    \\n",\n    "    optimizer = COBYLA(maxiter=50)\\n",\n    "    qaoa = QAOA(sampler, optimizer, reps=2)\\n",\n    "    \\n",\n    "    start_time = time.time()\\n",\n    "    result = qaoa.compute_minimum_eigenvalue(observable)\\n",\n    "    execution_time = time.time() - start_time\\n",\n    "    \\n",\n    "    best_bitstring = None\\n",\n    "    max_prob = 0\\n",\n    "    \\n",\n    "    for state_int, prob in result.eigenstate.items():\\n",\n    "        bitstring = format(state_int, f'0{observable.num_qubits}b')\\n",\n    "        if prob > max_prob:\\n",\n    "            max_prob = prob\\n",\n    "            best_bitstring = bitstring\\n",\n    "            \\n",\n    "    x = [int(bit) for bit in best_bitstring][::-1] \\n",\n    "    cut_value = maxcut.objective_value(x)\\n",\n    "    \\n",\n    "    return {\\n",\n    "        'Processor': processor_name, \\n",\n    "        'Execution_Time_sec': round(execution_time, 2), \\n",\n    "        'Max_Cut_Value': cut_value\\n",\n    "    }\\n",\n    "\\n",\n    "# ==========================================\\n",\n    "# 6. RUN EXPERIMENTS & EXPORT DATA\\n",\n    "# ==========================================\\n",\n    "results_data = []\\n",\n    "for name, backend in processors.items():\\n",\n    "    results_data.append(benchmark_qaoa(name, backend, observable))\\n",\n    "\\n",\n    "df_results = pd.DataFrame(results_data)\\n",\n    "csv_path = f\\\"{dirs['tables']}/PS_O1_benchmark_results.csv\\\"\\n",\n    "df_results.to_csv(csv_path, index=False)\\n",\n    "\\n",\n    "print(\\\"\\\\n==========================================\\\")\\n",\n    "print(\\\"BENCHMARK COMPLETE\\\")\\n",\n    "print(\\\"==========================================\\\")\\n",\n    "print(df_results.to_string(index=False))\\n"\n   ]\n  }\n ],\n "metadata": {},\n "nbformat": 4,\n "nbformat_minor": 5\n}
